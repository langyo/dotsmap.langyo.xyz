{
  "name": "dotsmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "pnpm run build && wrangler dev",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b --noEmit",
    "clean": "rm -rf dist node_modules/.vite",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "pinia": "^2",
    "vue": "^3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.0",
    "@eslint/js": "^9",
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^5",
    "@vitejs/plugin-vue-jsx": "^4",
    "eslint": "^9",
    "sass": "^1",
    "stylelint": "^16",
    "stylelint-config-standard-scss": "^14",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "unocss": "^66",
    "vite": "^6",
    "vue-tsc": "^2",
    "wrangler": "^4.98.0"
  }
}
