{
  "name": "dotsmap",
  "version": "0.3.0",
  "private": true,
  "license": "SySL-1.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-favicons.mjs && vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "stylelint": "stylelint \"src/**/*.{css,scss,vue}\"",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "lucide-vue-next": "^1",
    "pinia": "^2",
    "qrcode": "^1",
    "vue": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "@types/qrcode": "^1",
    "@vitejs/plugin-vue": "^5",
    "@vitejs/plugin-vue-jsx": "^4",
    "eslint": "^9",
    "sass": "^1",
    "sharp": "^0",
    "stylelint": "^16",
    "stylelint-config-standard-scss": "^14",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "unocss": "^66",
    "vite": "^6",
    "vitest": "^4",
    "vue-tsc": "^2"
  }
}
